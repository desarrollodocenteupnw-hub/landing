---
import {dimensions,cmsText} from '../lib/content';

const connections = [
  'M242 202 208 168Q192 152 170 152H124V124',
  'M318 202 352 168Q368 152 390 152H436V124',
  'M242 278 208 312Q192 328 170 328H124V356',
  'M318 278 352 312Q368 328 390 328H436V356'
];
const points = [[124,124],[436,124],[124,356],[436,356]];
---
<div
  class="mide-visual mide-system"
  data-mide-motion
  role="img"
  aria-label="Medición Integral de Excelencia Docente. Cuatro dimensiones conectadas: Docencia, Investigación, Visión global e Impacto social."
>
  <div class="mide-system-heading" aria-hidden="true">
    <span>{cmsText('mide.graph.heading','Una mirada integral')}</span><span>{cmsText('mide.graph.count','04 dimensiones')}</span>
  </div>
  <div class="mide-system-diagram" aria-hidden="true">
    <svg class="mide-system-connections" viewBox="0 0 560 480" fill="none" focusable="false">
      <circle class="mide-system-guide" cx="280" cy="240" r="100"/>
      {connections.map((path,index)=><g style={`--mide-step:${index}`}>
        <path class="mide-system-track" d={path}/>
        <path class="mide-system-trace" d={path} pathLength="1"/>
        <circle class="mide-system-point" cx={points[index][0]} cy={points[index][1]} r="4"/>
      </g>)}
    </svg>
    {dimensions.map((dim,index)=><div class={`mide-system-dimension mide-system-dimension--${index+1}`} style={`--mide-step:${index}`}>
      <span class="mide-system-number">{dim.number}</span>
      <strong>{dim.name}</strong>
    </div>)}
    <div class="mide-system-hub">
      <div class="mide-system-core"><span>{cmsText('mide.graph.brand','MIDE')}</span><small>{cmsText('mide.graph.core','Desempeño docente')}</small></div>
    </div>
  </div>
  <p class="mide-system-caption">{cmsText('mide.graph.caption','Medición Integral de Excelencia Docente')}</p>
</div>

<style>
  /* This component owns its geometry: legacy page styles must not tilt the diagram. */
  .mide-visual.mide-system {
    position: relative;
    display: block;
    container-type: inline-size;
    width: 100%;
    min-width: 0;
    max-width: 540px;
    margin: 0 0 0 auto;
    aspect-ratio: auto;
    color: #111;
    background: #fff;
    border: 1px solid #d9d9d9;
    border-radius: 0;
    box-shadow: none;
    isolation: isolate;
    transform: none !important;
  }
  .mide-system .mide-system-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 20px 22px 0;
    font-family: var(--font-ui,'Hanken Grotesk',Arial,sans-serif);
    font-size: 10px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .mide-system .mide-system-heading span:last-child { color: #626262; }
  .mide-system .mide-system-diagram {
    position: relative;
    width: 100%;
    aspect-ratio: 560/480;
  }
  .mide-system .mide-system-connections {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .mide-system .mide-system-guide { stroke: #e6e6e6; stroke-width: 1; }
  .mide-system .mide-system-track { stroke: #dedede; stroke-width: 2; }
  .mide-system .mide-system-trace {
    stroke: #07c8cc;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .mide-system .mide-system-point { fill: #111; }
  .mide-system .mide-system-dimension {
    position: absolute;
    display: grid;
    justify-items: center;
    gap: 9px;
    width: 42%;
    padding-inline: 5px;
    text-align: center;
    font-family: var(--font-ui,'Hanken Grotesk',Arial,sans-serif);
  }
  .mide-system .mide-system-dimension--1 { left: 1%; top: 6%; }
  .mide-system .mide-system-dimension--2 { right: 1%; top: 6%; }
  .mide-system .mide-system-dimension--3 { left: 1%; bottom: 6%; }
  .mide-system .mide-system-dimension--4 { right: 1%; bottom: 6%; }
  .mide-system .mide-system-number {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid #d4d4d4;
    border-radius: 50%;
    color: #555;
    font-size: 10px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: .02em;
  }
  .mide-system .mide-system-dimension strong {
    display: block;
    color: #111;
    font-size: clamp(14px,3.9cqw,21px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -.025em;
  }
  .mide-system .mide-system-hub {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 29%;
    aspect-ratio: 1;
    transform: translate(-50%,-50%);
  }
  .mide-system .mide-system-core {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-radius: 50%;
    background: #07c8cc;
    color: #111;
    box-shadow: 0 0 0 9px #fff;
  }
  .mide-system .mide-system-core > span {
    font-family: var(--font-display,N27,Arial,sans-serif);
    font-size: clamp(25px,8.3cqw,45px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -.04em;
  }
  .mide-system .mide-system-core > small {
    max-width: 84%;
    font-family: var(--font-ui,'Hanken Grotesk',Arial,sans-serif);
    font-size: clamp(8px,1.95cqw,10px);
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
  }
  .mide-system .mide-system-caption {
    margin: 0 22px;
    padding: 15px 0 18px;
    border-top: 1px solid #e0e0e0;
    color: #555;
    font-family: var(--font-ui,'Hanken Grotesk',Arial,sans-serif);
    font-size: clamp(11px,2.6cqw,13px);
    font-weight: 400;
    line-height: 1.45;
    text-align: center;
  }
  .mide-system.mide-sequence-ready:not(.mide-is-active) .mide-system-trace { stroke-dashoffset: 1; }
  .mide-system.mide-sequence-ready:not(.mide-is-active) .mide-system-dimension,
  .mide-system.mide-sequence-ready:not(.mide-is-active) .mide-system-point { opacity: 0; }
  .mide-system.mide-is-active .mide-system-core {
    animation: mideHubResolve .65s cubic-bezier(.22,1,.36,1) both;
  }
  .mide-system.mide-is-active .mide-system-trace {
    animation: mideConnectionDraw .75s cubic-bezier(.22,1,.36,1) both;
    animation-delay: calc(.12s + var(--mide-step) * .14s);
  }
  .mide-system.mide-is-active .mide-system-dimension,
  .mide-system.mide-is-active .mide-system-point {
    animation: mideDimensionReveal .65s cubic-bezier(.22,1,.36,1) both;
    animation-delay: calc(.25s + var(--mide-step) * .14s);
  }
  @keyframes mideHubResolve {
    from { opacity: 0; scale: .94; }
    to { opacity: 1; scale: 1; }
  }
  @keyframes mideConnectionDraw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes mideDimensionReveal {
    from { opacity: 0; translate: 0 6px; }
    to { opacity: 1; translate: 0 0; }
  }
  @container (max-width:360px) {
    .mide-system .mide-system-heading { padding: 16px 14px 0; font-size: 9px; letter-spacing: .035em; }
    .mide-system .mide-system-dimension { gap: 6px; }
    .mide-system .mide-system-number { width: 23px; height: 23px; font-size: 9px; }
    .mide-system .mide-system-core { gap: 4px; box-shadow: 0 0 0 6px #fff; }
    .mide-system .mide-system-caption { margin-inline: 14px; padding: 13px 0 15px; }
  }
  @media (prefers-reduced-motion:reduce) {
    .mide-visual.mide-system * { animation: none !important; }
    .mide-visual.mide-system .mide-system-trace { stroke-dashoffset: 0 !important; }
    .mide-visual.mide-system .mide-system-dimension,
    .mide-visual.mide-system .mide-system-point { opacity: 1 !important; translate: none !important; }
    .mide-visual.mide-system .mide-system-core { opacity: 1 !important; scale: 1 !important; }
  }
  :global(html[data-motion=reduced]) .mide-visual.mide-system * { animation: none !important; }
  :global(html[data-motion=reduced]) .mide-visual.mide-system .mide-system-trace { stroke-dashoffset: 0 !important; }
  :global(html[data-motion=reduced]) .mide-visual.mide-system .mide-system-dimension,
  :global(html[data-motion=reduced]) .mide-visual.mide-system .mide-system-point { opacity: 1 !important; translate: none !important; }
  :global(html[data-motion=reduced]) .mide-visual.mide-system .mide-system-core { opacity: 1 !important; scale: 1 !important; }
</style>
