---
import {heroPhoto} from '../lib/media';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProcessMark from '../components/ProcessMark.astro';
import MideGraphic from '../components/MideGraphic.astro';
import {content,processes,processCopy,todayLima,currentPeriod,processIconIndex,cmsText} from '../lib/content';
import {upcomingActivities,reportedExecution} from '../lib/schedule';
const today=todayLima();
const upcoming=upcomingActivities(content.actividades,today,4);
const slideNames=[1,2,3,4,5,6,7].map(i=>cmsText(`presentation.slide${i}.name`,['El área','Cinco procesos','Metas y contribución','Evaluación MIDE','Innovación','Próximas fechas','Comunidad'][i-1]));
const lines=(id:string,fallback:string)=>cmsText(id,fallback).split('\n');
---
<Layout title={cmsText('presentation.title','Presentación del área')} minimal>
<div class="presentation-shell" id="presentation-shell"><header class="presentation-header"><a href="/" aria-label={cmsText('presentation.back','Volver al portal')}><img src="/assets/wiener-dark.png" alt={cmsText('global.brand.alt','Universidad Norbert Wiener')} width="170" height="38"/></a><span>{cmsText('presentation.header','Desarrollo Docente · Modo presentación')}</span><a href="/" class="presentation-exit">{cmsText('presentation.exit','Salir')} <Icon name="close" size={19}/></a></header>
<div class="presentation-deck" id="presentation-deck">
  <section class="presentation-slide presentation-cover" data-slide data-slide-name={slideNames[0]} aria-label={`1 de 7: ${slideNames[0]}`}><div class="presentation-cover-copy"><span class="eyebrow">{cmsText('presentation.slide1.kicker','Dirección de Gestión y Desarrollo Docente')}</span><h1>{lines('presentation.slide1.title','Desarrollo\nDocente.').map((line,i)=><>{i>0&&<br/>}{line}</>)}</h1><p>{cmsText('presentation.slide1.body','Una mirada integral al recorrido docente Wiener.')}</p><div class="presentation-cover-meta"><span>{cmsText('presentation.slide1.meta1','05 procesos')}</span><span>{cmsText('presentation.slide1.meta2','Planificación del área')}</span></div></div><div class="presentation-cover-photo"><img src={heroPhoto.src} alt={heroPhoto.alt} width="1200" height="1600"/><span>{cmsText('presentation.slide1.photo','Comunidad docente Wiener')}</span></div></section>
  <section class="presentation-slide" data-slide data-slide-name={slideNames[1]} aria-label={`2 de 7: ${slideNames[1]}`}><div class="presentation-heading"><span class="eyebrow">{cmsText('presentation.slide2.kicker','El mismo nivel de compromiso')}</span><h2>{lines('presentation.slide2.title','Cinco procesos.\nUn recorrido conectado.').map((line,i)=><>{i>0&&<br/>}{line}</>)}</h2><p>{cmsText('presentation.slide2.body','Inducción, Formación, Acompañamiento, Evaluación y Reconocimiento articulan el desarrollo docente.')}</p></div><div class="presentation-processes">{processes.map((p,i)=><a href={`/procesos/${p.slug}/`}><span class="index">0{i+1}</span><ProcessMark index={processIconIndex(p.slug)}/><h3>{p.eje}</h3><p>{p.beneficio || processCopy[p.slug].benefit}</p><Icon name="diagonal" size={19}/></a>)}</div></section>
  <section class="presentation-slide" data-slide data-slide-name={slideNames[2]} aria-label={`3 de 7: ${slideNames[2]}`}><div class="presentation-heading"><span class="eyebrow">{cmsText('presentation.slide3.kicker','Contribución de todos los procesos')}</span><h2>{lines('presentation.slide3.title','Metas que orientan\nnuestro trabajo.').map((line,i)=><>{i>0&&<br/>}{line}</>)}</h2><p>{cmsText('presentation.slide3.body_prefix','Una selección de las metas del periodo')} {currentPeriod}. {cmsText('presentation.slide3.body_suffix','Los resultados se consultan cuando están publicados.')}</p></div><div class="presentation-metas">{processes.map(p=>{const k=content.kpis.find(k=>k.eje===p.eje && k.periodo===currentPeriod);return <article><span class="eyebrow">{p.eje}</span>{k?<><span class="presentation-meta-number">{k.meta}<small>{k.unidad}</small></span><span class="micro">{cmsText('presentation.slide3.meta','Meta')} · {k.periodo}</span><h3>{k.indicador}</h3></>:<><span class="presentation-meta-number" aria-label={cmsText('presentation.no_meta','Sin meta publicada')}>—</span><span class="micro">{cmsText('presentation.slide3.pending','Meta pendiente de publicación')}</span><h3>{p.beneficio||processCopy[p.slug].benefit}</h3></>}</article>})}</div><a class="text-link presentation-detail-link" href="/resultados/">{cmsText('presentation.slide3.cta','Consultar los indicadores y resultados')} <Icon name="diagonal" size={18}/></a></section>
  <section class="presentation-slide presentation-mide" data-slide data-slide-name={slideNames[3]} aria-label={`4 de 7: ${slideNames[3]}`}><div class="presentation-heading"><span class="eyebrow">{cmsText('presentation.slide4.kicker','Evaluación / Consulta ejecutiva')}</span><h2>{lines('presentation.slide4.title','Comprender\nel desempeño.\nOrientar la mejora.').map((line,i)=><>{i>0&&<br/>}{line}</>)}</h2><p>{cmsText('presentation.slide4.body','La Medición Integral de Excelencia Docente reúne cuatro dimensiones de la labor docente.')}</p><div class="button-row"><a class="button button--ink" href="/procesos/evaluacion/">{cmsText('presentation.slide4.cta1','Explorar MIDE')} <Icon name="diagonal" size={18}/></a><a class="text-link" href="/agenda/?proceso=evaluacion">{cmsText('presentation.slide4.cta2','Revisar etapas')} <Icon size={18}/></a></div></div><MideGraphic/></section>
  <section class="presentation-slide" data-slide data-slide-name={slideNames[4]} aria-label={`5 de 7: ${slideNames[4]}`}><div class="presentation-heading"><span class="eyebrow">{cmsText('presentation.slide5.kicker','Innovación y mejora')}</span><h2>{lines('presentation.slide5.title','Perspectivas que amplían\nla experiencia docente.').map((line,i)=><>{i>0&&<br/>}{line}</>)}</h2></div><div class="presentation-innovation">{[1,2,3].map(i=><article><div class="presentation-symbol" aria-hidden="true">{cmsText(`presentation.slide5.card${i}.symbol`,i===1?'IA↗':i===2?'[ • ]':'+↗')}</div><span class="eyebrow">{cmsText(`presentation.slide5.card${i}.kicker`,i===1?'Capacidades':i===2?'Práctica':'Evidencias')}</span><h3>{cmsText(`presentation.slide5.card${i}.title`,i===1?'IA, entornos digitales y metodologías activas.':i===2?'Observación y retroalimentación personalizada.':'Un modelo integral del desempeño docente.')}</h3><p>{cmsText(`presentation.slide5.card${i}.body`,i===1?'Exploración a través de rutas y módulos de formación.':i===2?'Una conversación cercana sobre lo que ocurre en el aula.':'Distintas dimensiones para una lectura más completa.')}</p></article>)}</div><a class="text-link presentation-detail-link" href="/innovacion/">{cmsText('presentation.slide5.cta','Explorar los enfoques de los cinco procesos')} <Icon name="diagonal" size={18}/></a></section>
  <section class="presentation-slide" data-slide data-slide-name={slideNames[5]} aria-label={`6 de 7: ${slideNames[5]}`}><div class="presentation-heading"><span class="eyebrow">{cmsText('presentation.slide6.kicker','Agenda del área')}</span><h2>{lines('presentation.slide6.title','Fechas claras.\nAcciones identificadas.').map((line,i)=><>{i>0&&<br/>}{line}</>)}</h2><p>{cmsText('presentation.slide6.body','Una vista ejecutiva de las próximas actividades publicadas.')}</p></div><div class="presentation-agenda" data-presenter-agenda>{upcoming.map(a=><a href={`/agenda/?actividad=${a.id}&periodo=${a.periodo}`}><span class="eyebrow">{a.eje} / {a.periodo}</span><h3>{a.titulo_claro||a.actividad}</h3><p>{a.inicio} — {a.fin}</p><span class="micro">{cmsText('presentation.responsible','Responsable:')} {a.responsable}{reportedExecution(a)}</span></a>)}</div><a class="text-link presentation-detail-link" href="/agenda/">{cmsText('presentation.slide6.cta','Abrir agenda y cronograma completos')} <Icon name="diagonal" size={18}/></a></section>
  <section class="presentation-slide presentation-closing" data-slide data-slide-name={slideNames[6]} aria-label={`7 de 7: ${slideNames[6]}`}><div><span class="eyebrow">{cmsText('presentation.slide7.kicker','Comunidad docente Wiener')}</span><h2>{lines('presentation.slide7.title','El valor\nde encontrarnos.\nY de reconocer.').map((line,i)=><>{i>0&&<br/>}{line}</>)}</h2><p>{cmsText('presentation.slide7.body','Cinco procesos al servicio del desarrollo docente y de la mejora de la experiencia educativa.')}</p><a href="/el-area/#equipo" class="button button--teal">{cmsText('presentation.slide7.cta','Conoce al equipo')} <Icon name="diagonal" size={18}/></a></div><img src="/assets/gala-comunidad.webp" alt={cmsText('presentation.slide7.image_alt','Un grupo de participantes conversa alrededor de una mesa en el encuentro docente')} width="1600" height="1200" loading="lazy"/></section>
</div>
<footer class="presentation-controls"><button class="icon-button" id="slide-prev" aria-label={cmsText('presentation.prev','Diapositiva anterior')}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6"/></svg></button><div class="presentation-progress" role="group" aria-label={cmsText('presentation.choose','Elegir diapositiva')}>{slideNames.map((label,i)=><button data-go-slide={i} aria-label={`${i+1}. ${label}`} aria-pressed={i===0}><span></span></button>)}</div><span class="presentation-counter" aria-live="polite" id="slide-counter">01 / 07</span><button class="icon-button" id="slide-next" aria-label={cmsText('presentation.next','Siguiente diapositiva')}><Icon size={20}/></button><button class="fullscreen-button" id="presentation-fullscreen" aria-label={cmsText('presentation.fullscreen','Pantalla completa')}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 9V3h6m6 0h6v6m0 6v6h-6m-6 0H3v-6"/></svg></button></footer><span class="presentation-keyboard-hint">{cmsText('presentation.keyboard','Navega con las flechas del teclado')}</span></div>
<script type="application/json" id="presentation-data" set:html={JSON.stringify(content.actividades).replace(/</g,'\u003c')}/>
<script>import '../scripts/presentation';</script>
</Layout>
<style is:global>
.is-presentation{background:var(--paper)}.is-presentation .reading-progress{display:none}.presentation-shell{min-height:100dvh;padding:0 55px;display:flex;flex-direction:column}.presentation-header{display:flex;justify-content:space-between;align-items:center;height:95px;gap:30px;border-bottom:1px solid var(--line);flex-shrink:0}.presentation-header img{width:164px;height:auto}.presentation-header>span{font-size:11px;color:var(--muted)}.presentation-exit{font-size:11px;display:flex;gap:12px;align-items:center;text-transform:uppercase;letter-spacing:.08em}.presentation-deck{flex:1;position:relative}.presentation-slide{padding:45px 0}.presentation-ready .presentation-deck{min-height:0;height:calc(100dvh - 180px);flex:none}.presentation-ready .presentation-slide{height:100%;overflow:auto;animation:presentationIn .65s var(--ease) both}.presentation-slide h2{font-size:clamp(36px,4.3vw,65px)}.presentation-heading{max-width:1000px;margin-bottom:35px}.presentation-heading h2{margin:15px 0 20px}.presentation-heading>p{font-size:14px;max-width:600px}.presentation-cover{display:grid;grid-template-columns:1.1fr 1fr;gap:80px;align-items:center}.presentation-cover h1{font-size:clamp(74px,8.9vw,145px);line-height:.94;margin:30px 0;letter-spacing:-.07em}.presentation-cover-copy>p{font-size:22px;max-width:400px}.presentation-cover-meta{display:flex;gap:30px;font-size:11px;margin-top:45px;text-transform:uppercase;letter-spacing:.1em}.presentation-cover-photo{height:100%;max-height:650px;min-height:360px;position:relative;clip-path:polygon(15% 0,100% 0,100% 83%,83% 100%,0 100%,0 15%)}.presentation-cover-photo img{width:100%;height:100%;object-fit:cover;object-position:50% 45%}.presentation-cover-photo span{position:absolute;left:25px;bottom:25px;background:white;padding:10px 15px;font-size:10px}.presentation-processes{display:grid;grid-template-columns:repeat(5,1fr);border:1px solid var(--line);background:white}.presentation-processes>a{padding:23px;min-height:290px;display:flex;flex-direction:column;align-items:flex-start;border-right:1px solid var(--line);transition:background .3s}.presentation-processes>a:last-child{border:0}.presentation-processes>a:hover{background:var(--teal)}.presentation-processes .process-mark{width:45px;height:45px;margin:25px 0}.presentation-processes h3{font-size:23px;margin-bottom:15px}.presentation-processes p{font-size:12px}.presentation-processes>a>svg:last-child{margin-top:auto;padding-top:17px;box-sizing:content-box}.presentation-metas{display:grid;grid-template-columns:repeat(5,1fr);gap:20px}.presentation-metas article{border-top:1px solid var(--ink);padding-top:20px}.presentation-metas .eyebrow{font-size:10px}.presentation-meta-number{display:block;font-size:75px;letter-spacing:-.06em;line-height:1.2;margin:25px 0 12px}.presentation-meta-number small{font-size:35px;margin-left:4px}.presentation-metas .micro{font-size:8px;color:var(--teal-deep)}.presentation-metas h3{font-size:17px;line-height:1.4;margin-top:15px;letter-spacing:-.02em}.presentation-detail-link{margin-top:35px;font-size:12px}.presentation-mide{display:grid;grid-template-columns:1.05fr 1fr;gap:100px;align-items:center}.presentation-mide .mide-visual{max-width:460px}.presentation-mide .presentation-heading{margin:0}.presentation-mide .button-row{margin-top:30px}.presentation-innovation{display:grid;grid-template-columns:repeat(3,1fr);gap:40px}.presentation-innovation article{border-top:1px solid var(--line);padding-top:20px}.presentation-symbol{font-size:65px;line-height:1;letter-spacing:-.08em;margin:5px 0 25px;color:var(--teal-deep)}.presentation-innovation .eyebrow{font-size:9px}.presentation-innovation h3{font-size:27px;line-height:1.2;margin:13px 0 17px;max-width:350px}.presentation-innovation p{font-size:13px;max-width:320px}.presentation-agenda{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}.presentation-agenda a{padding:24px;background:white;border:1px solid var(--line);min-height:240px;display:flex;flex-direction:column}.presentation-agenda a:hover{border-color:var(--ink)}.presentation-agenda .eyebrow{font-size:9px;color:var(--teal-deep)}.presentation-agenda h3{font-size:24px;line-height:1.2;margin:25px 0 18px}.presentation-agenda p{font-size:12px;margin-bottom:25px}.presentation-agenda .micro{font-size:9px;margin-top:auto}.presentation-closing{display:grid;grid-template-columns:1fr 1.2fr;gap:65px;align-items:center}.presentation-closing h2{font-size:clamp(40px,5vw,76px);margin:25px 0}.presentation-closing p{max-width:420px;font-size:17px;margin-bottom:30px}.presentation-closing>img{width:100%;height:80%;min-height:350px;max-height:600px;object-fit:cover;object-position:50% 60%;clip-path:polygon(0 0,85% 0,100% 15%,100% 100%,15% 100%,0 85%)}.presentation-controls{height:80px;display:flex;align-items:center;gap:23px;border-top:1px solid var(--line);flex-shrink:0}.presentation-controls>.icon-button{border-color:#17202133}.presentation-controls>.icon-button:disabled{opacity:.25;cursor:default;transform:none}.presentation-progress{display:flex;gap:8px;flex:1;max-width:420px}.presentation-progress button{padding:12px 0;flex:1}.presentation-progress button span{height:3px;background:var(--line);display:block;transition:background .3s}.presentation-progress button[aria-pressed=true] span{background:var(--teal-deep)}.presentation-counter{font-size:12px;letter-spacing:.08em;white-space:nowrap}.fullscreen-button{margin-left:auto;display:grid;place-items:center;width:35px;height:35px}.presentation-keyboard-hint{font-size:9px;position:fixed;bottom:30px;left:calc(50% + 140px);color:var(--muted);pointer-events:none}@keyframes presentationIn{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
@media(max-height:780px) and (min-width:900px){.presentation-header{height:75px}.presentation-ready .presentation-deck{height:calc(100dvh - 145px)}.presentation-slide{padding:30px 0}.presentation-slide h2{font-size:44px}.presentation-heading{margin-bottom:25px}.presentation-heading h2{margin:10px 0 15px}.presentation-processes>a{min-height:250px;padding:20px}.presentation-processes .process-mark{margin:20px 0;width:38px;height:38px}.presentation-processes h3{font-size:21px}.presentation-controls{height:70px}.presentation-meta-number{font-size:60px;margin:15px 0 10px}.presentation-mide .mide-visual{max-width:350px}.presentation-cover h1{font-size:100px}.presentation-cover-photo{min-height:300px}.presentation-symbol{font-size:50px;margin-bottom:15px}.presentation-innovation h3{font-size:22px}.presentation-agenda a{min-height:210px}.presentation-agenda h3{font-size:21px;margin-top:18px}.presentation-detail-link{margin-top:23px}.presentation-keyboard-hint{bottom:26px}}
@media(max-width:1000px){.presentation-shell{padding-inline:32px}.presentation-cover{gap:35px}.presentation-cover h1{font-size:83px}.presentation-cover-copy>p{font-size:19px}.presentation-mide{gap:55px}.presentation-processes>a{padding:18px}.presentation-processes h3{font-size:19px}.presentation-metas{gap:15px}.presentation-meta-number{font-size:62px}.presentation-metas h3{font-size:14px}.presentation-innovation{gap:28px}.presentation-innovation h3{font-size:23px}.presentation-agenda{grid-template-columns:repeat(2,1fr);gap:15px}.presentation-agenda a{min-height:0;padding:22px}.presentation-agenda h3{font-size:22px;margin:17px 0 12px}.presentation-agenda p{margin-bottom:15px}.presentation-closing{gap:35px}.presentation-keyboard-hint{display:none}}
@media(max-width:700px){.presentation-shell{padding:0 20px}.presentation-header{height:76px;gap:20px}.presentation-header img{width:135px}.presentation-header>span{display:none}.presentation-exit{font-size:9px;gap:7px}.presentation-ready .presentation-deck{height:calc(100dvh - 150px)}.presentation-slide{padding:27px 0}.presentation-cover{display:flex;flex-direction:column;gap:25px;align-items:stretch}.presentation-cover h1{font-size:17vw;margin:20px 0;line-height:.95}.presentation-cover-copy>.eyebrow{font-size:8px}.presentation-cover-copy>p{font-size:16px;max-width:260px}.presentation-cover-meta{display:none}.presentation-cover-photo{min-height:230px;max-height:380px;flex:1}.presentation-cover-photo img{object-position:50% 50%}.presentation-cover-photo span{font-size:8px;left:18px;bottom:18px}.presentation-heading{margin-bottom:25px}.presentation-heading h2,.presentation-slide h2{font-size:36px;margin:13px 0 18px}.presentation-heading>p{font-size:12px}.presentation-processes{grid-template-columns:1fr}.presentation-processes>a{display:grid;grid-template-columns:30px 1fr 20px;column-gap:15px;min-height:0;padding:18px;border-right:0;border-bottom:1px solid var(--line)}.presentation-processes .index{grid-column:1;grid-row:1;padding-top:3px;font-size:9px}.presentation-processes .process-mark{display:none}.presentation-processes h3{grid-column:2;grid-row:1;margin:0;font-size:23px}.presentation-processes p{grid-column:2;font-size:12px;margin-top:8px}.presentation-processes>a>svg:last-child{grid-column:3;grid-row:1;margin:0;padding:0}.presentation-metas{grid-template-columns:1fr 1fr;gap:25px 22px}.presentation-metas article:last-child{grid-column:1/-1}.presentation-metas .eyebrow{font-size:8px}.presentation-meta-number{font-size:49px;margin:15px 0 5px}.presentation-meta-number small{font-size:25px}.presentation-metas h3{font-size:13px;margin-top:12px}.presentation-detail-link{font-size:11px;gap:13px;margin-top:25px;margin-bottom:10px}.presentation-mide{display:flex;flex-direction:column;gap:40px}.presentation-mide .mide-visual{width:85%;max-width:400px;margin:0 auto 40px;flex-shrink:0}.presentation-mide .button-row{margin-top:20px}.presentation-mide .button{font-size:12px;padding:15px 18px;min-height:48px;gap:17px}.presentation-mide .text-link{font-size:11px}.presentation-innovation{grid-template-columns:1fr;gap:25px}.presentation-innovation article{display:grid;grid-template-columns:70px 1fr;column-gap:20px}.presentation-symbol{grid-column:1;grid-row:1/4;font-size:38px;padding-top:15px}.presentation-innovation .eyebrow{grid-column:2;font-size:8px}.presentation-innovation h3{font-size:22px;grid-column:2;margin:10px 0 13px}.presentation-innovation p{grid-column:2;font-size:12px}.presentation-agenda{grid-template-columns:1fr;gap:15px}.presentation-agenda a{padding:22px}.presentation-agenda h3{font-size:22px}.presentation-closing{display:flex;flex-direction:column;gap:25px;align-items:stretch}.presentation-closing h2{font-size:43px}.presentation-closing p{font-size:15px;max-width:330px}.presentation-closing .button{font-size:12px;padding:15px 18px}.presentation-closing>img{min-height:250px;height:auto;max-height:390px}.presentation-controls{height:74px;gap:14px}.presentation-controls .icon-button{width:34px;height:34px}.presentation-progress{gap:5px}.presentation-counter{font-size:10px}.fullscreen-button{width:25px;height:30px;margin-left:0}.presentation-ready .presentation-slide{padding-bottom:25px}}
</style>

<style is:global>
.presentation-ready .presentation-slide{overflow-x:hidden;min-width:0}.presentation-heading{min-width:0}.presentation-mide{grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:70px}.presentation-mide .mide-visual{width:calc(100% - 24px);margin-right:12px;max-width:430px}.presentation-mide .mide-center{width:100px;height:100px;font-size:24px}
@media(max-width:700px){.presentation-mide{gap:40px}.presentation-mide .mide-visual{width:85%;margin:0 auto 40px}.presentation-mide .mide-center{width:92px;height:92px;font-size:23px}}
</style>
