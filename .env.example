# Solo para el proceso de construcción. Nunca usar prefijos PUBLIC_ para secretos.
# Sin estas variables se construye con el snapshot validado incluido.
APPS_SCRIPT_CONTENT_URL=
APPS_SCRIPT_CONTENT_TOKEN=

# Versión exacta para builds manuales conectados a Apps Script.
# Los builds iniciados por Apps Script reciben la versión en INCOMING_HOOK_BODY.
# No fijar CONTENT_VERSION si se usará el flujo de publicación desde el menú.
CONTENT_VERSION=
